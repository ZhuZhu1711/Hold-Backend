# --- Python 缓存文件 ---
# 忽略所有层级的 __pycache__ 目录
__pycache__/
*.py[cod]
*$py.class
*.so

# 版本说明（root 按版本上传）
data/release_notes/
data/release_notes_test/
data/release_notes.md
data/release_notes.meta.json
data/release_notes_test.md
data/release_notes_test.meta.json
data/*.tmp

# --- 日志文件 ---
# 忽略 logs 目录下的所有文件，但保留目录本身
logs/*
# 如果 logs 下可能有子文件夹，也忽略其内容
logs/**/*

testlog_temp_dir/*

# 离线训练产物，不入库
app/hold_predict/artifacts/*.joblib

build/
dist/
venv/
venv_packages/
.vscode/